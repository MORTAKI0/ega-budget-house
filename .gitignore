# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo

# package manager caches
.npm
.pnpm-store

# convex local generated/dev files
.convex
convex/_generated

# optional local assets / temp
.tmp
.temp
.cache
.codex-tmp
