# ------------------------------------------------------------
# EGA BUDGET HOUSE - Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local.
# ------------------------------------------------------------


# ------------------------------------------------------------
# Convex
# Required for connecting the Next.js app to Convex.
# Get this from your Convex dashboard or from `npx convex dev`.
# ------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=


# ------------------------------------------------------------
# App
# Public app URL.
# Local development example: http://localhost:3000
# Production example: https://ega-budget-house.vercel.app
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ------------------------------------------------------------
# Convex Auth
# Password auth uses these Convex deployment environment variables.
# Set real values with `npx @convex-dev/auth --web-server-url http://localhost:3000`
# or in the Convex dashboard. Do not store real key material here.
# ------------------------------------------------------------
SITE_URL=http://localhost:3000
JWT_PRIVATE_KEY=
JWKS=


# ------------------------------------------------------------
# Resend - Later
# Only needed later if we add email features:
# password reset, monthly summary, reminders, alerts.
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# ------------------------------------------------------------
# Optional Analytics - Later
# ------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
